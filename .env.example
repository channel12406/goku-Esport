# Configuration Firebase
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# ⚠️ CRITIQUE POUR LA SÉCURITÉ PXP ⚠️
# Robot de service Firebase pour les écritures serveur sécurisées
# Ce compte DOIT être créé dans Firebase Auth avant le déploiement
FIREBASE_ROBOT_EMAIL="robotfirearena@gmail.com"
FIREBASE_ROBOT_PASSWORD="changez_ce_mot_de_passe_complexe"

# UID des administrateurs (séparés par des virgules)
# Ces UIDs doivent correspondre aux comptes admin dans Firebase Auth
ADMIN_UIDS="admin_uid_1,admin_uid_2"

# Domaine email des administrateurs (un compte dont l'email se termine par ce
# domaine est traité comme admin, côté serveur ET dans les règles Firestore)
ADMIN_EMAIL_DOMAIN="@firearena.gg"
